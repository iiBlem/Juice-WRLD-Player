{
  "name": "juice-player",
  "version": "0.1.0",
  "private": true,
  "description": "Juice Player desktop scaffold",
  "author": "Chase H",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc -p tsconfig.electron.json && tsc --noEmit -p tsconfig.json && vite build && electron-builder --dir",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "42.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "local.juiceplayer.desktop",
    "productName": "Juice Player",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/icon.png", "to": "icon.png" }
    ],
    "win": {
      "signExecutable": false,
      "icon": "build/icon.ico"
    }
  }
}
