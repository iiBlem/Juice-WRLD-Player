      \n          // Apply to html immediately (this always exists)\n          if (shouldUseDark) {\n            html.classList.add('body--dark');\n            html.classList.remove('body--light');\n          } else {\n            html.classList.add('body--light');\n            html.classList.remove('body--dark');\n          }\n          \n          // Apply to body when it becomes available\n          const applyToBody = () => {\n            const body = document.body;\n            if (!body) return;\n            \n            // Add preload class to prevent transitions\n            body.classList.add('preload');\n            \n            if (shouldUseDark) {\n              body.classList.add('body--dark');\n              body.classList.remove('body--light');\n            } else {\n              body.classList.add('body--light');\n              body.classList.remove('body--dark');\n            }\n            \n            // Remove preload class after a short delay to re-enable transitions\n            setTimeout(() => {\n              body.classList.remove('preload');\n              body.classList.add('loaded');\n            }, 100);\n          };\n          \n          // Apply to body when DOM is ready\n          if (document.readyState === 'loading') {\n            document.addEventListener('DOMContentLoaded', applyToBody);\n          } else {\n            applyToBody();\n          }\n        } catch (error) {\n          console.error('Error applying theme:', error);\n          \n          // Fallback to light mode if localStorage fails\n          const html = document.documentElement;\n          html.classList.add('body--light');\n          html.classList.remove('body--dark');\n          \n          const applyToBodyFallback = () => {\n            const body = document.body;\n            if (!body) return;\n            \n            body.classList.add('preload');\n            body.classList.add('body--light');\n            body.classList.remove('body--dark');