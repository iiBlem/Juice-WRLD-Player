tHome = () => {\n          try {\n            localStorage.setItem('node_setup_completed', 'true')\n          } catch (e) {\n          }\n          window.location.replace('/')\n        }\n\n        Promise.all([\n          fetch(getApiBaseUrl() + '/slave/status/', { cache: 'no-store' }).then((response) => response.ok ? response.json() : null).catch(() => null),\n          fetch(getApiBaseUrl() + '/stats/', { cache: 'no-store' }).then((response) => response.ok ? response.json() : null).catch(() => null)\n        ]).then(([slaveStatus, stats]) => {\n          const totalFiles = readCount(slaveStatus && slaveStatus.total_files)\n          const totalSongs = readCount(stats && stats.total_songs)\n          if (totalFiles > 0 || totalSongs > 0) {\n            redirectHome()\n          }\n        }).catch(() => {\n        })\n      })()</script>  <script type=\"module\" crossorigin src=\"/assets/index.a2647ba9.js\"></script>\n  <link rel=\"modulepreload\" href=\"/assets/vendor.8d923c7d.js\">\n  <link rel=\"modulepreload\" href=\"/assets/axios.ab682c6b.js\">\n  <link rel=\"stylesheet\" href=\"/assets/index.03735d5d.css\">\n</head><body><script src=\"/./app-config.js\"></script><div id=q-app></div></body></html>"
